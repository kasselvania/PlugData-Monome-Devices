#N canvas 170 80 1120 680 12;
#X text 30 20 monome-session — explicit SerialOSC session lifecycle workbench;
#X text 30 50 In Terminal from this repository: python3 tools/fake_serialosc.py;
#X msg 30 120 start;
#X msg 105 120 select m100 monome\ 128 17001;
#X msg 350 120 probe;
#X msg 430 120 claim;
#X msg 510 120 check;
#X msg 585 120 release;
#X msg 675 120 stop;
#X msg 755 120 bang;
#X msg 840 120 prefix /plugdata;
#X obj 30 190 monome-session 17780 120;
#X obj 30 250 print session-status;
#X obj 410 250 print unhandled-device-osc;
#X text 30 310 Required order: start -> select -> probe -> claim.;
#X text 30 340 check verifies that host / port / prefix still belong to this session.;
#X text 30 370 release probes again and sends /sys/port 0 only when ownership still matches.;
#X text 30 420 Simulate another application in the fake-server terminal:;
#X text 30 450 displace m100 127.0.0.1 19999 /rival;
#X text 30 480 Then click check. Expected state: displaced.;
#X text 30 510 Clicking release while displaced must not overwrite the rival destination.;
#X text 30 560 Callback 17780 is separate from discovery callback 17779.;
#X text 30 590 This patch never touches live SerialOSC discovery port 12002.;
#X msg 30 155 protocol lease;
#X msg 155 155 protocol legacy;
#X msg 290 155 takeover;
#X text 30 625 Lease mode fails closed when unsupported. takeover is explicit and never implied by probe.;
